{
  "name": "arcanemp-thai-menu",
  "version": "0.3.0",
  "private": true,
  "description": "Portable Windows Thai menu installer for structurally compatible ArcaneMP clients",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "powershell -NoProfile -File scripts/build-installer.ps1",
    "build:legacy": "node scripts/build.cjs",
    "verify": "node scripts/verify.cjs",
    "qa": "node scripts/qa.cjs",
    "qa:installer": "node scripts/qa-installer.cjs"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "subset-font": "2.9.0"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
